# ===========================
# AutoPR - Environment Config
# ===========================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file!

# ---- Google / Gemini ----
GEMINI_API_KEY=

# ---- Linear ----
LINEAR_API_KEY=

# ---- GitHub ----
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=AutoPR

# ---- Discord ----
DISCORD_WEBHOOK_URL=

# ---- Optional: Local LLM (Ollama) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3

# ---- Server Config ----
API_HOST=0.0.0.0
API_PORT=8000

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
